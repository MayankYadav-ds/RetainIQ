# Copy to backend/.env; values are non-secret local defaults.
RETAINIQ_ENVIRONMENT=development
RETAINIQ_DATABASE_URL=sqlite:///./retainiq.db
RETAINIQ_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RETAINIQ_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
# Frontend build-time variable; never put a secret in VITE_*.
# VITE_API_BASE_URL=http://127.0.0.1:8000
