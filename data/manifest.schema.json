{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RetainIQ acquired dataset manifest",
  "type": "object",
  "required": [
    "dataset_name",
    "source",
    "license",
    "version",
    "sha256",
    "acquired_at",
    "schema",
    "prediction_target",
    "supported_prediction_horizons_days",
    "provenance",
    "known_limitations"
  ],
  "properties": {
    "dataset_name": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "acquired_at": {
      "type": "string",
      "format": "date-time"
    },
    "schema": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "dtype"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "dtype": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "prediction_target": {
      "type": "string"
    },
    "supported_prediction_horizons_days": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "provenance": {
      "type": "string"
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
